<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mania-difficulty-ref</AssemblyName>
    <RootNamespace>ManiaDifficulty.ReferenceRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(OSU_GAME_PATH)' != ''">
