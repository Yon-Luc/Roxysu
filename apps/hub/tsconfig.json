{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../..",
    "paths": {
      "@roxysu/db": ["../../packages/db/src/index.ts"],
      "@roxysu/db/hub": ["../../packages/db/src/hub/index.ts"],
      "@roxysu/db/hub/schema": ["../../packages/db/src/hub/schema.ts"]
    }
  },
  "include": ["src/**/*", "../../packages/db/src/hub/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
