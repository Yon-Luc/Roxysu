# Optional overrides — copy to .env if needed.
# Precedence: OSU_DATA_PATH / REALM_PATH → Settings UI → platform default.

# osu!lazer data directory (contains client.realm and files/)
# Windows: %APPDATA%\osu
# macOS:   ~/Library/Application Support/osu
# Linux:   ~/.local/share/osu
# OSU_DATA_PATH=

# Or point directly at client.realm (also implies data dir = parent)
# REALM_PATH=

# Local SQLite database (default: apps/server/data.sqlite)
# DB_PATH=

# Force a full Realm reconcile on reader start
# REALM_FULL_SYNC=1

# Realm poll interval in ms (default: 60000)
# REALM_RESYNC_MS=60000

# Beatmapset .osz mirror for /api/mirrors/.../download (nerinyan | osu.direct | hinai)
# hinai (mirror.hinamizawa.ai) is a no-auth fallback mirror with a 7-source
# download cascade and richer search filters (stars/bpm/length/pp); good
# alternative if nerinyan/osu.direct are rate-limiting.
# BEATMAP_MIRROR_PROVIDER=nerinyan

# Folder for batch .osz downloads (default: ~/Downloads/beatmaps)
# BEATMAPS_DOWNLOAD_DIR=
