<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mania-rating-calc</AssemblyName>
    <RootNamespace>ManiaRatingCalc</RootNamespace>
  </PropertyGroup>

  <!--
    Build against a local osu!lazer checkout. Set OSU_GAME_PATH to the repo root:
      OSU_GAME_PATH=/path/to/osu dotnet publish -c Release -o dist/my-version
  -->
  <ItemGroup Condition="'$(OSU_GAME_PATH)' != ''">
    <ProjectReference Include="$(OSU_GAME_PATH)/osu.Game/osu.Game.csproj" />
  </ItemGroup>
</Project>
