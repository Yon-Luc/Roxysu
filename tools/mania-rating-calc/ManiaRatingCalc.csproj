<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mania-rating-calc</AssemblyName>
    <RootNamespace>ManiaRatingCalc</RootNamespace>
  </PropertyGroup>

  <!-- Reference snapshots for diff review — not part of the build -->
  <ItemGroup>
    <Compile Remove="docs/**" />
    <None Include="docs/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(OSU_GAME_PATH)' != ''">
    <ProjectReference Include="$(OSU_GAME_PATH)/osu.Game/osu.Game.csproj" />
    <ProjectReference Include="$(OSU_GAME_PATH)/osu.Game.Rulesets.Mania/osu.Game.Rulesets.Mania.csproj" />
  </ItemGroup>
</Project>
