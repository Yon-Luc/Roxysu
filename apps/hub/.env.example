# osu! OAuth — register at https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=http://localhost:4322/auth/callback

# After OAuth, hub redirects here with ?h=… (one-time handoff id, not the JWT)
HUB_CLIENT_REDIRECT_URI=http://127.0.0.1:4321/#/hub-callback

# Electron system-browser handoff (local Roxysu marks handoff ready; app polls)
HUB_DESKTOP_REDIRECT_URI=http://127.0.0.1:4321/api/system/hub-oauth/complete

# JWT — required (≥32 chars). Never use a placeholder in production.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Local-only escape hatch when JWT_SECRET is unset (never in production)
# HUB_ALLOW_INSECURE_JWT=1

# SQLite path (mounted volume in production)
DATABASE_URL=./data/hub.sqlite

# Server
PORT=4322
# Set HUB_ENV=production (or NODE_ENV=production) to fail closed on weak secrets
# HUB_ENV=production
CORS_ORIGIN=*

# Cache TTL in ms (default 24h)
HUB_CACHE_TTL_MS=86400000

# Trust X-Real-Ip / last X-Forwarded-For hop. Set when Hub sits behind a reverse proxy.
# Leave unset when Hub is reached directly (spoofable forwarded headers are ignored).
# HUB_TRUST_PROXY=1

# Your osu! user ID — promoted to admin on login. Existing admins are not demoted if this is unset.
ADMIN_OSU_ID=
