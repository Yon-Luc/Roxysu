{
  "name": "@roxysu/desktop",
  "productName": "Roxysu",
  "version": "0.0.1",
  "private": true,
  "description": "Roxysu Electron shell (Windows product path; NixOS/Linux for smoke-testing)",
  "main": "main.js",
  "scripts": {
    "dev": "bun run --cwd ../server build:ui && node ./scripts/run-electron.mjs .",
    "start": "node ./scripts/run-electron.mjs .",
    "dev:smoke": "node ./scripts/run-electron.mjs .",
    "build:stage": "node ./scripts/build-pack.mjs",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "archive:realm": "node ./scripts/archive-realm.mjs",
    "build:launcher": "node ./scripts/build-win-launcher.mjs",
    "pack": "bun run build:stage && bun run rebuild:native && bun run archive:realm",
    "assert:packaged": "node ./scripts/assert-packaged.mjs",
    "dist:win": "bun run build:launcher && bun run pack && electron-builder --win && bun run assert:packaged",
    "dist:dir": "bun run pack && electron-builder --dir && bun run assert:packaged"
  },
  "build": {
    "appId": "dev.roxysu.desktop",
    "productName": "Roxysu",
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/after-pack.mjs",
    "icon": "../server/public/icons/icon-512.png",
    "files": [
      "main.js",
      "preload.js",
      "paths.js"
    ],
    "extraResources": [
      {
        "from": "stage/public",
        "to": "public"
      },
      {
        "from": "stage/server",
        "to": "server"
      },
      {
        "from": "stage/node",
        "to": "node"
      },
      {
        "from": "stage/realm-reader.tgz",
        "to": "realm-reader.tgz"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../server/public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^42.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0"
  }
}
